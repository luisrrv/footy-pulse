# Copy to .env and fill in: cp .env.example .env
# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Daily digest job only (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API-Football via RapidAPI
NEXT_PUBLIC_RAPID_API_KEY=your-rapidapi-key
NEXT_PUBLIC_RAPID_API_HOST=api-football-v1.p.rapidapi.com

# Optional: pin the season (defaults to the current season by date)
# FOOTBALL_SEASON=2025
